# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the publishable key if your project shows one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects expose an anon key instead. Either public key works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only GitHub token for public repository/issue discovery. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional. Used on the analysis page to rewrite the contributor brief. Never prefix with NEXT_PUBLIC_.
COHERE_API_KEY=
# Optional override. Defaults to command-a-03-2025.
# COHERE_MODEL=command-a-03-2025

